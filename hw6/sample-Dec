

/* Sample circuit to show you how to use the built-in Dec (decoder) circuit */



/* ======================================================================
   How to use the built-in Dec:

      Dec  coord  ONE  N sel-signals | 2^N outputs ;

   A 2x4 decoder is created as follows:

      Dec  aa  ONE  c1 c0  | out3  out2  out1  out0
                    ^^^^^    ^^^^^^^^^^^^^^^^^^^^^^
                    2 sel         2^2 output      
                    signals       signals

   ====================================================================== */

// Here, I make a 3x8 decoder: 3 selection signals to pick one of 8 (=2^3) outputs
Dec  cb-eb  ONE  c[2..0] | out[7..0] ;


Switch ca c[2] '2' ZERO;
Switch da c[1] '1' ZERO;
Switch ea c[0] '0' ZERO;
   
ProbeH ac out[7];
ProbeH bc out[6];
ProbeH cc out[5];
ProbeH dc out[4];
ProbeH ec out[3];
ProbeH fc out[2];
ProbeH gc out[1];
ProbeH hc out[0];

